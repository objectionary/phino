⟦
  eo ↦ ⟦
    example ↦ ⟦
      fibonacci(n) ↦ ⟦
        φ ↦ n.lt(x ↦ 2).if(
          left ↦ n,
          right ↦ Φ.eo.example.fibonacci(n ↦ n.minus(x ↦ 1)).plus(
            x ↦ Φ.eo.example.fibonacci(n ↦ n.minus(x ↦ 2))
          )
        )
      ⟧,
      λ ⤍ Package
    ⟧,
    λ ⤍ Package
  ⟧
⟧
