⟦
  bytes ↦ ⟦ φ ↦ ∅ ⟧,
  bool ↦ ⟦ if ↦ ∅ ⟧,
  number ↦ ⟦
    φ ↦ ∅,
    plus(ρ, x) ↦ ⟦ λ ⤍ L_number_plus ⟧,
    times(ρ, x) ↦ ⟦ λ ⤍ L_number_times ⟧,
    gt(ρ, x) ↦ ⟦ λ ⤍ L_number_gt ⟧,
    neg(ρ) ↦ ⟦ φ ↦ ξ.ρ.times( x ↦ -1 ) ⟧,
    minus(ρ, x) ↦ ⟦ φ ↦ ξ.ρ.plus( x ↦ ξ.x.neg ) ⟧
  ⟧,
  demo ↦ ⟦
    gap(a, b) ↦ ⟦ φ ↦ ξ.a.minus( x ↦ ξ.b ).times( x ↦ ξ.a.minus( x ↦ ξ.b ) ) ⟧,
    far(p, q) ↦ ⟦ φ ↦ Φ.demo.gap( a ↦ ξ.p, b ↦ ξ.q ).gt( x ↦ 100 ) ⟧,
    clamp(x, lo, hi) ↦ ⟦ φ ↦ ξ.x.gt( x ↦ ξ.hi ).if( left ↦ ξ.hi, right ↦ ξ.lo.gt( x ↦ ξ.x ).if( left ↦ ξ.lo, right ↦ ξ.x ) ) ⟧,
    twice(t) ↦ ⟦ φ ↦ ξ.t.gt( x ↦ 0 ).if( left ↦ ξ.t.plus( x ↦ 1 ), right ↦ ξ.t.plus( x ↦ 2 ) ).plus( x ↦ ξ.t.plus( x ↦ 1 ) ) ⟧
  ⟧,
  l🌵 ↦ ⟦
    mark(n, v) ↦ ⟦ λ ⤍ L_entry ⟧,
    e1 ↦ Φ.l🌵.mark( n ↦ 1, v ↦ Φ.demo.gap( a ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎1 ⟧ ) ), b ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎2 ⟧ ) ) ) ),
    e2 ↦ Φ.l🌵.mark( n ↦ 2, v ↦ Φ.demo.far( p ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎3 ⟧ ) ), q ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎4 ⟧ ) ) ) ),
    e3 ↦ Φ.l🌵.mark( n ↦ 3, v ↦ Φ.demo.clamp( x ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎5 ⟧ ) ), lo ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎6 ⟧ ) ), hi ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎7 ⟧ ) ) ) ),
    e4 ↦ Φ.l🌵.mark( n ↦ 4, v ↦ Φ.demo.twice( t ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎8 ⟧ ) ) ) ),
    e5 ↦ Φ.l🌵.mark( n ↦ 5, v ↦ Φ.number( φ ↦ Φ.bytes( φ ↦ ⟦ λ ⤍ 𝜎9 ⟧ ) ).neg )
  ⟧
⟧
